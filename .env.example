# Copy this file to .env and fill in your key.
# NEVER commit .env, and NEVER expose GEMINI_API_KEY in frontend code.

# Google AI Studio API key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# API key that callers must send in the "X-API-Key" header to use the /api/* endpoints.
# Choose any long random secret. If left unset the API runs OPEN (dev) - set it for prod.
API_KEY=choose-a-long-random-secret

# Which Gemini model to use. "gemini-flash-latest" always tracks Google's current
# stable flash model, so it never breaks when an older pinned version is retired.
# Pin an exact version instead if you want deterministic behavior, e.g. gemini-3.6-flash.
GEMINI_MODEL=gemini-flash-latest

# Port the uvicorn server listens on
PORT=3001

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Leave unset to use the local dev defaults (localhost:3000/5173/5174/5175).
# In production add your real frontend URL, e.g.:
# ALLOWED_ORIGINS=https://app.scaleserum.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# MongoDB (Atlas) connection string — stores the Brand Brain, keyed by brand_brain_id.
# Get it from Atlas: Cluster -> Connect -> Drivers -> copy the mongodb+srv URI, and
# replace <password> with your DB user's password. Leave unset to run WITHOUT Brand
# Brain storage (the /api/brand-brain/save|get endpoints will return 503).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=scaleserum

# ---------------------------------------------------------------------------
# Sales Call Analyzer
# ---------------------------------------------------------------------------
# Deepgram API key -> https://console.deepgram.com  (server-side ONLY; never
# expose it to frontend code). Leave unset to run WITHOUT transcription: the
# analyzer still accepts supplied transcripts and reports
# "transcription_not_configured" for audio, and the rest of the app is
# unaffected.
# DEEPGRAM_API_KEY=your_key_here

# Which Deepgram model to use. Change without touching code, like GEMINI_MODEL.
DEEPGRAM_MODEL=nova-3

# Language sent when a request carries no language_hint. "multi" is Deepgram's
# code-switching mode: one pass handles an all-English call, an all-Hindi call,
# and a call that opens in English and continues in Hindi.
#
# multi covers Hindi only among Indian languages. A Marathi, Tamil, Telugu,
# Kannada, Bengali, Gujarati, Punjabi or Urdu call must send its own code as
# options.language_hint on the request.
DEEPGRAM_LANGUAGE=multi

# Deepgram's own detection is OFF on purpose. It picks ONE language from the
# whole file, our reps open in English and do most of the talking, so it answers
# "en" and the customer's regional speech is lost. Measured: it returned "en" at
# 98.5% confidence for a Marathi customer. Setting this true restores that bug.
DEEPGRAM_DETECT_LANGUAGE=false

# How long to wait for a transcription (seconds) and how many times to retry a
# transient provider error.
DEEPGRAM_TIMEOUT_SECONDS=300
DEEPGRAM_MAX_RETRIES=2

# true  = hand Deepgram the recording URL (default; no audio passes through this
#         server, and the recording host must be reachable by Deepgram)
# false = fetch the bytes here and forward them (for private storage only this
#         service can read)
SCA_DEEPGRAM_URL_INGESTION=true

# How many calls may be transcribed/analysed at once. This is a single pm2 fork
# process shared with onboarding and Script Lab - keep it small.
SCA_MAX_CONCURRENT_JOBS=2

# A job whose heartbeat stops for this long is reported as interrupted and can be
# retried. A pm2 restart mid-analysis (i.e. every deploy) is the usual cause.
SCA_JOB_STALE_SECONDS=900

# Keep the raw Deepgram response? Off by default: word-level output for a long
# call is megabytes with no consumer beyond debugging a diarization complaint.
# Stored in its own collection with a TTL when enabled.
SCA_STORE_RAW_TRANSCRIPT=false
SCA_RAW_TRANSCRIPT_TTL_DAYS=30

# Automatic language detection: off | shadow | on.
#
# Deepgram cannot be asked what language a call is in - it answers "en" for a
# Marathi customer because the rep does most of the talking in English. So a
# short window of the audio is sent to Gemini, which reports the share of each
# language, and a regional call is then transcribed with its own language code.
#
#   off     never runs. The default: it costs a Gemini call per analysis.
#   shadow  runs and records what it WOULD have chosen, changes nothing. Watch
#           processing.language_shadow_choice on live calls before trusting it.
#   on      acts on the answer.
#
# A caller-supplied options.language_hint always wins and skips detection.
SCA_LANGUAGE_ID=shadow

# With detection on, a call that is at least this % English is sent as `en`
# rather than `multi`: multi writes some accented English words in Devanagari
# and is billed at the multilingual rate. Hindi is never overridden.
SCA_ENGLISH_ONLY_MIN_SHARE=95

# A regional code (mr, kn, ...) is sent only when that language is at least this
# % of the speech. A regional model cannot write English, so on a mixed call it
# garbles the rep's half; below this the call stays on multi (complete, with the
# regional part rough) and is recorded as language_decision=regional_minority.
SCA_REGIONAL_MIN_SHARE=80

# Keyterms: the brand, product, rep and customer names are sent to Deepgram so
# it spells them correctly ("Manjunaf Gouda" -> "Manjunath Gowda"). Those names
# are what speaker-role resolution searches for. nova-3 only.
SCA_DEEPGRAM_KEYTERMS=true
SCA_DEEPGRAM_MAX_KEYTERMS=20

# Keep "um"/"uh" in English transcripts. For hesitation detection (later); off
# because it changes the text that evidence quotes are verified against.
SCA_DEEPGRAM_FILLER_WORDS=false

# Dropped-speech guard. A call longer than SCA_COVERAGE_MIN_DURATION_SECONDS
# whose transcribed turns cover less than this share of the recording gets the
# `low_speech_coverage` warning. Deepgram's confidence stays high on the words
# it keeps, so this is the only signal that speech was lost.
SCA_MIN_SPEECH_COVERAGE=0.6
SCA_COVERAGE_MIN_DURATION_SECONDS=30

# Tone: off | shadow | on - HOW things were said, from the audio.
#
# Measures every turn (pace, pauses, loudness, pitch, reply latency,
# interruptions, fillers - relative to each speaker's own usual) and has Gemini
# LISTEN to up to 12 key turns (price, objections, the customer's last words,
# turns that sound unusual) for: neutral, interested, confident, hesitant,
# confused, frustrated, urgent, disengaged. The report gains `voice`, and the
# analysis is told how it was said instead of guessing tone from the words.
#
# Measured on sentences whose words carry no tone: text alone is at chance;
# on real actors (CREMA-D, 5 emotions) listening scores 48% against 20% chance -
# about what human listeners manage from the voice alone. Tone is useful
# evidence, not a verdict. ~$0.02 of Gemini per 10-minute call.
SCA_TONE=shadow
# SCA_TONE_MODEL=gemini-flash-latest          # defaults to GEMINI_MODEL
# SCA_TONE_MAX_MOMENTS=12

# Segment pass: off | shadow | on.
#
# On a call where the rep speaks English and the customer a regional language
# (Kannada, Marathi, Punjabi, Tamil, Telugu, ...), `multi` loses or garbles the
# customer's half and a regional model garbles the rep's. The segment pass
# re-transcribes ONLY the customer's turns with Gemini in their own language;
# Deepgram keeps the timings and speakers, and the original text is kept on each
# segment. Measured on the customer's turns of the synthetic regional calls:
# WER 52-61% -> 9-32% (Tamil 54% -> 9%, Kannada 52% -> 23%).
#
# Needs SCA_LANGUAGE_ID shadow/on (or a regional options.language_hint) to know
# the language. Skips English, Hindi (multi handles it) and calls already sent
# wholly in the regional language. ~$0.01 of Gemini per call that uses it.
SCA_SEGMENT_PASS=shadow
# SCA_SEGMENT_PASS_MODEL=gemini-flash-latest        # defaults to GEMINI_MODEL
# SCA_SEGMENT_PASS_MIN_SHARE=10                     # % of speech that must be regional
# SCA_SEGMENT_PASS_THINKING_BUDGET=                 # empty = model default; 0 was measured worse
# Which turns: all (default) | mixed | customer. On calls where the rep code-switches
# too (like testaudio/mycall4.mp3) the rep's WER was 33% with `customer`, 26% with
# `mixed`, 12% with `all`. When the rep speaks only English, `all` costs ~3x and
# the rep's English is slightly worse (6.5% -> 9.4%). ~$0.02 per call with `all`.
# SCA_SEGMENT_PASS_SCOPE=all
# SCA_SEGMENT_PASS_GAP_FILL_SECONDS=1.0             # read into silence after a turn

# Speaker refinement: off | shadow | on.
#
# Deepgram's diarization clusters voices blind. Measured on synthetic calls with
# exact truth: same-gender pairs collapsed into ONE speaker (4 of 16), a rep who
# switched English->Hindi became TWO speakers, and one-word customer replies
# landed on the rep ~80% of the time. Refinement checks every stretch of speech
# against the voices, and against the rep's enrolled voiceprint when there is
# one (POST /api/sales-calls/reps/{rep_id}/voiceprint). With a voiceprint from
# two calls, role accuracy rose from 78% to 90% and 15 of 16 calls had both
# roles right. Without one it stays conservative and changes little.
#
#   off     never runs (default).
#   shadow  measures and records processing.speaker_refinement, changes nothing.
#   on      the refined speakers are the transcript's speakers.
#
# Costs ~27 s of CPU per 10-minute call, in this process. No API spend.
SCA_SPEAKER_REFINE=shadow

# Folder holding the voice models - OUTSIDE the app directory, because deploy.sh
# runs `git reset --hard`. Install with: python scripts/fetch_sca_models.py
# SCA_MODEL_DIR=/srv/scaleserum-models/sca
# SCA_SPEAKER_MODEL=3dspeaker_speech_eres2net_sv_en_voxceleb_16k.onnx
# SCA_VOICE_THREADS=1

# A voice at or above this similarity to the rep's voiceprint is the rep; below
# REJECT it is not; in between Deepgram's label stands. Calibrated on synthetic
# calls - recalibrate with scripts/sca_eval once real calls are labelled.
# SCA_VOICEPRINT_MATCH_AT=0.40
# SCA_VOICEPRINT_REJECT_BELOW=0.35

# With voice activity detection, a call keeping less than this share of its
# detected speech inside transcribed turns gets `low_speech_coverage`.
SCA_MIN_SPEECH_KEPT=0.7

# Which model identifies the language. Defaults to GEMINI_MODEL.
# SCA_LANGUAGE_ID_MODEL=gemini-flash-latest

# The sample sent for identification. Starts after the greeting because the
# opening is in English on almost every call. About $0.002 for three minutes.
SCA_LANGUAGE_ID_WINDOW_START=20
SCA_LANGUAGE_ID_WINDOW_SECONDS=180

# Without ffmpeg no window can be cut, so the whole recording is sent instead -
# but only when it is smaller than this, since Gemini charges by audio length.
SCA_LANGUAGE_ID_MAX_WHOLE_BYTES=8388608

# Where ffmpeg lives, if not on PATH. VL_FFMPEG_DIR is used as a fallback, so a
# server already running Vision Lab needs nothing here.
# SCA_FFMPEG_DIR=

# Provider rates for cost estimates and GET /api/sales-calls/billing/summary.
# Defaults to billing/pricing.json. Override only to trial different rates.
# BILLING_PRICING_PATH=/root/Scale-Serum/billing/pricing.json

# Log level for the new structured logging. Never logs keys, signed URLs,
# transcript text or customer contact details.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Vision Lab (AI-predicted attention analysis for ad creatives)
# ---------------------------------------------------------------------------
# Off by default. Merging an unfinished Vision Lab onto main - which deploys
# itself - must land inert code, not a half-built feature. Turn it on only when
# the milestone is signed off; it is an .env edit plus a pm2 restart, not a deploy.
VL_ENABLED=false

# Which hosts a creative URL may point at, comma-separated. Accepting an
# arbitrary URL and fetching it server-side is SSRF; this is what bounds it.
# Use the S3 bucket's host, e.g. my-bucket.s3.ap-south-1.amazonaws.com
# VL_ALLOWED_URL_HOSTS=

# Local development ONLY - skips the allowlist above. Never set this in production.
VL_ALLOW_ANY_URL=false

# Frame sampling. 2 fps over a 24 s ad is 48 frames, which is what the Vision
# Lab prototype reports.
VL_SAMPLE_FPS=2.0
VL_MAX_FRAMES=120
VL_MAX_DURATION_SECONDS=180

# The worker is CPU-bound and shares this box with onboarding, Script Lab and
# the Sales Call Analyzer. Keep it at 1 here.
VL_MAX_CONCURRENT_JOBS=1
VL_WORKER_IDLE_SLEEP=3
VL_REAP_INTERVAL_SECONDS=120

# A job a worker has STARTED whose heartbeat stops for this long is reported as
# interrupted and can be retried - a pm2 restart mid-analysis is the usual cause.
# A job still waiting in the queue is never failed for waiting, however long the
# queue; VL_QUEUE_UNCLAIMED_ALERT_SECONDS is how a missing worker shows instead.
# Longer than the sales-call equivalent because a long video legitimately takes
# minutes.
VL_JOB_STALE_SECONDS=1800

# How long the per-frame measurement record is kept. This is what /rescore
# reads, so an expired record means a creative can no longer be rescored
# without re-processing it.
VL_MEASUREMENTS_TTL_DAYS=180

# How often the frontend should poll, advertised in every POST response.
VL_POLL_INTERVAL_SECONDS=5

# /health reports the worker unhealthy when jobs have waited this long with none
# being processed. A running worker that is idle claims a job within seconds,
# so this means no worker is running.
VL_QUEUE_UNCLAIMED_ALERT_SECONDS=60

# From Milestone B: the ONNX saliency weights, provisioned OUTSIDE the app
# directory because deploy.sh runs `git reset --hard` on every deploy. An empty
# directory degrades the feature with a stated reason rather than crashing.
# VL_MODEL_DIR=/root/models/vision_lab

# Milestone A only: how long a stubbed video claims to be, so a stub run
# produces a realistic frame count. Remove when media.py lands.
VL_STUB_DURATION_SECONDS=24

# --- Vision Lab: Milestone B (real frames, saliency, OCR, heatmaps) ---------
# Where ffmpeg lives, if it is not on PATH. winget adds it to PATH but an
# already-open shell does not see that, so a freshly provisioned box works while
# the terminal that provisioned it does not.
# VL_FFMPEG_DIR=

# Frames are scaled to this width for processing. Big enough for OCR to read
# 20 px type, small enough that 120 frames stay under ~40 MB of RAM.
VL_WORK_WIDTH=640

# Refuse a creative larger than this rather than filling the disk.
VL_MAX_DOWNLOAD_MB=400
VL_DOWNLOAD_TIMEOUT_SECONDS=600
VL_FFMPEG_TIMEOUT_SECONDS=600

# ffmpeg scene-change sensitivity. Lower fires on camera movement, higher misses
# soft transitions.
VL_SCENE_THRESHOLD=0.4

# OCR. "none" disables it; word counts then report null rather than 0, because
# "we could not read it" and "there was nothing to read" are different findings.
VL_OCR_ENGINE=tesseract
VL_OCR_MIN_CONFIDENCE=45
# VL_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# How confident a wordmark template match must be to count as a brand appearance.
VL_BRAND_MATCH_THRESHOLD=0.6

# Heatmap overlay opacity, and where the PNGs go in the bucket.
VL_HEATMAP_ALPHA=0.55
VL_THUMBNAIL_WIDTH=320
VL_S3_PREFIX=vision-lab

# POST /api/vision-lab/upload. Uploads get their own prefix so a lifecycle
# rule can expire them without touching heatmaps or the reference ads. The
# size cap defaults to VL_MAX_DOWNLOAD_MB so the two routes cannot disagree.
# The returned link outlives a heatmap link on purpose: the worker downloads
# the file only when it reaches the job, which can be well after the upload.
VL_UPLOAD_PREFIX=vision-lab-uploads
# VL_MAX_UPLOAD_MB=400
VL_UPLOAD_URL_TTL_SECONDS=21600

# Force the stubs even where ffmpeg and OpenCV are installed - useful for
# reproducing a contract issue without waiting on real processing.
VL_USE_REAL_VISION=true

# --- Vision Lab: OCR tuning (learned from real ScaleSerum creatives) --------
# PAGE SEGMENTATION MODE. Tesseract defaults to PSM 3, which assumes a document
# page. An ad frame is a few words over a photograph. Measured on a real
# creative: PSM 3 read ZERO words; PSM 11 ("sparse text") read the brand name at
# 92% confidence off the same pixels. Do not change this without re-measuring.
VL_OCR_PSM=11

# Language packs, "+"-separated. ScaleSerum's creatives are frequently Hinglish,
# and English alone cannot read Devanagari - the Hindi half of a subtitle comes
# back as noise and the word count silently undercounts.
#   Linux:   apt install -y tesseract-ocr-hin
#   Or drop hin.traineddata into VL_TESSDATA_DIR (see below).
VL_OCR_LANGUAGES=eng+hin

# Where the language packs live. Tesseract's own tessdata directory needs root
# to write to; pointing at one we own makes adding a language a file copy
# instead of a privileged install. When set, tesseract looks ONLY here, so every
# language in use must be present (eng included).
# VL_TESSDATA_DIR=/root/tessdata

# ---------------------------------------------------------------------------
# Sales Call Analyzer - transcription provider: deepgram (default) | sarvam
#
# Sarvam AI (saaras:v3, codemix, diarized, Batch API). Measured on 19 calls with
# exact truth: words on the right speaker 95% vs 75% with Deepgram; on real human
# speech (FLEURS) better in 7 of 8 Indian languages. With sarvam:
#   * no Gemini language identification and no segment pass (Sarvam handles both)
#   * the transcript is cleaned: echoed fragments removed, stray-script words
#     transliterated, brand/product names corrected (transcription/sarvam_cleanup.py)
#   * turns with a likely misheard term are re-checked by Gemini (SCA_SARVAM_RECHECK)
#   * if Sarvam fails (no key, no credits, outage) the call uses Deepgram instead
# Cost: Rs 45 per audio hour (Rs 0.75/min) + ~Rs 0.2-0.6 Gemini re-check per call.
# Needs `pip install sarvamai`.
SCA_TRANSCRIBER=deepgram
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=codemix
# SARVAM_STT_SPEAKERS=2
# SARVAM_STT_TIMEOUT_SECONDS=900
# SCA_SARVAM_RECHECK=on                              # Gemini re-check of flagged turns
# SCA_SARVAM_RECHECK_MODEL=gemini-flash-latest       # defaults to GEMINI_MODEL
# SCA_SARVAM_RECHECK_THINKING_BUDGET=512             # caps cost; one run used 10k thinking tokens
# SCA_SARVAM_VOICEPRINT=on                           # match the rep's enrolled voiceprint
