# Copy this file to .env and fill in your key.
# NEVER commit .env, and NEVER expose GEMINI_API_KEY in frontend code.

# Google AI Studio API key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# API key that callers must send in the "X-API-Key" header to use the /api/* endpoints.
# Choose any long random secret. If left unset the API runs OPEN (dev) - set it for prod.
API_KEY=choose-a-long-random-secret

# Which Gemini model to use. "gemini-flash-latest" always tracks Google's current
# stable flash model, so it never breaks when an older pinned version is retired.
# Pin an exact version instead if you want deterministic behavior, e.g. gemini-3.6-flash.
GEMINI_MODEL=gemini-flash-latest

# Port the uvicorn server listens on
PORT=3001

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Leave unset to use the local dev defaults (localhost:3000/5173/5174/5175).
# In production add your real frontend URL, e.g.:
# ALLOWED_ORIGINS=https://app.scaleserum.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# MongoDB (Atlas) connection string — stores the Brand Brain, keyed by brand_brain_id.
# Get it from Atlas: Cluster -> Connect -> Drivers -> copy the mongodb+srv URI, and
# replace <password> with your DB user's password. Leave unset to run WITHOUT Brand
# Brain storage (the /api/brand-brain/save|get endpoints will return 503).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=scaleserum

# ---------------------------------------------------------------------------
# Sales Call Analyzer
# ---------------------------------------------------------------------------
# Deepgram API key -> https://console.deepgram.com  (server-side ONLY; never
# expose it to frontend code). Leave unset to run WITHOUT transcription: the
# analyzer still accepts supplied transcripts and reports
# "transcription_not_configured" for audio, and the rest of the app is
# unaffected.
# DEEPGRAM_API_KEY=your_key_here

# Which Deepgram model to use. Change without touching code, like GEMINI_MODEL.
# Evaluate the newer/multilingual models against real Hindi-English calls before
# switching - that is a measurement, not a guess.
DEEPGRAM_MODEL=nova-2

# Pin a language (e.g. en-IN) for a single-language deployment. Leave unset to
# let Deepgram detect it.
# DEEPGRAM_LANGUAGE=en-IN
DEEPGRAM_DETECT_LANGUAGE=true

# How long to wait for a transcription (seconds) and how many times to retry a
# transient provider error.
DEEPGRAM_TIMEOUT_SECONDS=300
DEEPGRAM_MAX_RETRIES=2

# true  = hand Deepgram the recording URL (default; no audio passes through this
#         server, and the recording host must be reachable by Deepgram)
# false = fetch the bytes here and forward them (for private storage only this
#         service can read)
SCA_DEEPGRAM_URL_INGESTION=true

# How many calls may be transcribed/analysed at once. This is a single pm2 fork
# process shared with onboarding and Script Lab - keep it small.
SCA_MAX_CONCURRENT_JOBS=2

# A job whose heartbeat stops for this long is reported as interrupted and can be
# retried. A pm2 restart mid-analysis (i.e. every deploy) is the usual cause.
SCA_JOB_STALE_SECONDS=900

# Keep the raw Deepgram response? Off by default: word-level output for a long
# call is megabytes with no consumer beyond debugging a diarization complaint.
# Stored in its own collection with a TTL when enabled.
SCA_STORE_RAW_TRANSCRIPT=false
SCA_RAW_TRANSCRIPT_TTL_DAYS=30

# Log level for the new structured logging. Never logs keys, signed URLs,
# transcript text or customer contact details.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Vision Lab (AI-predicted attention analysis for ad creatives)
# ---------------------------------------------------------------------------
# Off by default. Merging an unfinished Vision Lab onto main - which deploys
# itself - must land inert code, not a half-built feature. Turn it on only when
# the milestone is signed off; it is an .env edit plus a pm2 restart, not a deploy.
VL_ENABLED=false

# Which hosts a creative URL may point at, comma-separated. Accepting an
# arbitrary URL and fetching it server-side is SSRF; this is what bounds it.
# Use the S3 bucket's host, e.g. my-bucket.s3.ap-south-1.amazonaws.com
# VL_ALLOWED_URL_HOSTS=

# Local development ONLY - skips the allowlist above. Never set this in production.
VL_ALLOW_ANY_URL=false

# Frame sampling. 2 fps over a 24 s ad is 48 frames, which is what the Vision
# Lab prototype reports.
VL_SAMPLE_FPS=2.0
VL_MAX_FRAMES=120
VL_MAX_DURATION_SECONDS=180

# The worker is CPU-bound and shares this box with onboarding, Script Lab and
# the Sales Call Analyzer. Keep it at 1 here.
VL_MAX_CONCURRENT_JOBS=1
VL_WORKER_IDLE_SLEEP=3
VL_REAP_INTERVAL_SECONDS=120

# A job a worker has STARTED whose heartbeat stops for this long is reported as
# interrupted and can be retried - a pm2 restart mid-analysis is the usual cause.
# A job still waiting in the queue is never failed for waiting, however long the
# queue; VL_QUEUE_UNCLAIMED_ALERT_SECONDS is how a missing worker shows instead.
# Longer than the sales-call equivalent because a long video legitimately takes
# minutes.
VL_JOB_STALE_SECONDS=1800

# How long the per-frame measurement record is kept. This is what /rescore
# reads, so an expired record means a creative can no longer be rescored
# without re-processing it.
VL_MEASUREMENTS_TTL_DAYS=180

# How often the frontend should poll, advertised in every POST response.
VL_POLL_INTERVAL_SECONDS=5

# /health reports the worker unhealthy when jobs have waited this long with none
# being processed. A running worker that is idle claims a job within seconds,
# so this means no worker is running.
VL_QUEUE_UNCLAIMED_ALERT_SECONDS=60

# From Milestone B: the ONNX saliency weights, provisioned OUTSIDE the app
# directory because deploy.sh runs `git reset --hard` on every deploy. An empty
# directory degrades the feature with a stated reason rather than crashing.
# VL_MODEL_DIR=/root/models/vision_lab

# Milestone A only: how long a stubbed video claims to be, so a stub run
# produces a realistic frame count. Remove when media.py lands.
VL_STUB_DURATION_SECONDS=24

# --- Vision Lab: Milestone B (real frames, saliency, OCR, heatmaps) ---------
# Where ffmpeg lives, if it is not on PATH. winget adds it to PATH but an
# already-open shell does not see that, so a freshly provisioned box works while
# the terminal that provisioned it does not.
# VL_FFMPEG_DIR=

# Frames are scaled to this width for processing. Big enough for OCR to read
# 20 px type, small enough that 120 frames stay under ~40 MB of RAM.
VL_WORK_WIDTH=640

# Refuse a creative larger than this rather than filling the disk.
VL_MAX_DOWNLOAD_MB=400
VL_DOWNLOAD_TIMEOUT_SECONDS=600
VL_FFMPEG_TIMEOUT_SECONDS=600

# ffmpeg scene-change sensitivity. Lower fires on camera movement, higher misses
# soft transitions.
VL_SCENE_THRESHOLD=0.4

# OCR. "none" disables it; word counts then report null rather than 0, because
# "we could not read it" and "there was nothing to read" are different findings.
VL_OCR_ENGINE=tesseract
VL_OCR_MIN_CONFIDENCE=45
# VL_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# How confident a wordmark template match must be to count as a brand appearance.
VL_BRAND_MATCH_THRESHOLD=0.6

# Heatmap overlay opacity, and where the PNGs go in the bucket.
VL_HEATMAP_ALPHA=0.55
VL_THUMBNAIL_WIDTH=320
VL_S3_PREFIX=vision-lab

# POST /api/vision-lab/upload. Uploads get their own prefix so a lifecycle
# rule can expire them without touching heatmaps or the reference ads. The
# size cap defaults to VL_MAX_DOWNLOAD_MB so the two routes cannot disagree.
# The returned link outlives a heatmap link on purpose: the worker downloads
# the file only when it reaches the job, which can be well after the upload.
VL_UPLOAD_PREFIX=vision-lab-uploads
# VL_MAX_UPLOAD_MB=400
VL_UPLOAD_URL_TTL_SECONDS=21600

# Force the stubs even where ffmpeg and OpenCV are installed - useful for
# reproducing a contract issue without waiting on real processing.
VL_USE_REAL_VISION=true

# --- Vision Lab: OCR tuning (learned from real ScaleSerum creatives) --------
# PAGE SEGMENTATION MODE. Tesseract defaults to PSM 3, which assumes a document
# page. An ad frame is a few words over a photograph. Measured on a real
# creative: PSM 3 read ZERO words; PSM 11 ("sparse text") read the brand name at
# 92% confidence off the same pixels. Do not change this without re-measuring.
VL_OCR_PSM=11

# Language packs, "+"-separated. ScaleSerum's creatives are frequently Hinglish,
# and English alone cannot read Devanagari - the Hindi half of a subtitle comes
# back as noise and the word count silently undercounts.
#   Linux:   apt install -y tesseract-ocr-hin
#   Or drop hin.traineddata into VL_TESSDATA_DIR (see below).
VL_OCR_LANGUAGES=eng+hin

# Where the language packs live. Tesseract's own tessdata directory needs root
# to write to; pointing at one we own makes adding a language a file copy
# instead of a privileged install. When set, tesseract looks ONLY here, so every
# language in use must be present (eng included).
# VL_TESSDATA_DIR=/root/tessdata
