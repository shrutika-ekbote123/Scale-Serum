    {
      "name": "7. Lead card — the CRM screenshot lead",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/purchase-probability/{{leadCard}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "purchase-probability",
            "{{leadCard}}"
          ]
        },
        "description": "The exact lead from the CRM screenshot (Jarupla Govindu).\n\nProves the card is served by this endpoint and that lead_score (25/100) and purchase_probability (~1.4%) are different numbers. A UI showing '25%' as the purchase probability is reading leads.score, not the model."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "const card = b.lead_summary;",
              "",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('the lead card is populated', () => {",
              "  pm.expect(card.available).to.eql(true);",
              "  pm.expect(card.lead_score).to.be.a('number');",
              "  pm.expect(card.temperature).to.be.a('string');",
              "});",
              "",
              "// The bug this endpoint exists to remove. The CRM badge reads 'cold 25',",
              "// which is a score out of 100 - NOT a 25% chance of purchase.",
              "pm.test('lead_score is not the probability', () => {",
              "  pm.expect(card.lead_score).to.eql(25);",
              "  pm.expect(card.lead_score_max).to.eql(100);",
              "  pm.expect(b.purchase_probability).to.be.below(5);",
              "  pm.expect(b.purchase_probability).to.not.eql(card.lead_score);",
              "});",
              "",
              "pm.test('header tiles are mirrored at the top level', () => {",
              "  pm.expect(b.lead_score).to.eql(card.lead_score);",
              "  pm.expect(b.temperature).to.eql(card.temperature);",
              "  pm.expect(b.total_revenue).to.eql(card.total_revenue);",
              "  pm.expect(b.days_to_convert).to.eql(card.days_to_convert);",
              "  pm.expect(b.lifetime_value).to.eql(card.lifetime_value.amount);",
              "});",
              "",
              "// null and 0 are different facts and the API keeps them apart.",
              "pm.test('no payments yet is 0 revenue, not null', () => {",
              "  pm.expect(card.total_revenue).to.eql(0);",
              "  pm.expect(card.payment_count).to.eql(0);",
              "  pm.expect(card.converted).to.eql(false);",
              "});",
              "pm.test('days_to_convert is null, not 0, when unconverted', () => {",
              "  pm.expect(card.days_to_convert).to.eql(null);",
              "  pm.expect(card.converted_at).to.eql(null);",
              "});",
              "",
              "pm.test('lifetime value is an estimate and says so', () => {",
              "  pm.expect(card.lifetime_value.estimated).to.eql(true);",
              "  pm.expect(card.lifetime_value.basis).to.be.a('string');",
              "  // probability x the brand's median paid order, recomputable from the response",
              "  const expected = b.probability * card.lifetime_value.order_value_used;",
              "  pm.expect(card.lifetime_value.amount).to.be.closeTo(expected, 0.01);",
              "});",
              "",
              "console.log('probability', b.purchase_probability + '%',",
              "            '| lead_score', card.lead_score + '/100',",
              "            '| LTV', card.lifetime_value.amount,",
              "            '| revenue', card.total_revenue);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Lead card — a lead that actually paid",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/purchase-probability/{{leadConverted}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "purchase-probability",
            "{{leadConverted}}"
          ]
        },
        "description": "A converted lead: revenue, payment count, converted_at and days_to_convert are all real.\n\nShows lifetime_value switching from estimate to recorded revenue, and that the conversion still never reaches the model's inputs."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "const card = b.lead_summary;",
              "",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "pm.test('realised revenue is reported', () => {",
              "  pm.expect(card.total_revenue).to.be.above(0);",
              "  pm.expect(card.payment_count).to.be.above(0);",
              "  pm.expect(card.converted).to.eql(true);",
              "  pm.expect(card.converted_at).to.be.a('string');",
              "});",
              "",
              "pm.test('days_to_convert is a real number here', () => {",
              "  pm.expect(card.days_to_convert).to.be.a('number');",
              "});",
              "",
              "// A lead that has paid is not a forecast any more.",
              "pm.test('LTV is recorded revenue, not an estimate', () => {",
              "  pm.expect(card.lifetime_value.estimated).to.eql(false);",
              "  pm.expect(card.lifetime_value.amount).to.eql(card.total_revenue);",
              "  pm.expect(card.lifetime_value.basis).to.include('recorded');",
              "});",
              "",
              "// ...but the estimate is kept alongside so open and won leads stay comparable.",
              "pm.test('the probability-weighted estimate is still reported', () => {",
              "  pm.expect(card.lifetime_value.expected_amount).to.be.a('number');",
              "  pm.expect(card.lifetime_value.expected_amount).to.not.eql(card.total_revenue);",
              "});",
              "",
              "// The lead converted, but the model never saw that. Its inputs are the",
              "// point-in-time form submission only, so the probability stays near base rate.",
              "pm.test('conversion did not leak into the probability', () => {",
              "  pm.expect(b.purchase_probability).to.be.below(20);",
              "});",
              "",
              "console.log('revenue', card.total_revenue, '| LTV', card.lifetime_value.amount,",
              "            '| estimated', card.lifetime_value.estimated,",
              "            '| days to convert', card.days_to_convert);"
            ]
          }
        }
      ]
    }
  ]
}
