    {
      "name": "2. Scored lead — both layers active",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/purchase-probability/{{leadEngaged}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "purchase-probability",
            "{{leadEngaged}}"
          ]
        },
        "description": "A lead with real behavioural history (98 admissible events). Both layers fire: the engagement layer from its click/timeline history, and the brand layer because this lead's brand (Lawtorney) has since onboarded and is auto-resolved from the lead.\n\nSaves purchase_probability and lead_priority so request 3 can prove the invariant."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('lead is scorable', () => pm.expect(b.availability.available).to.eql(true));",
              "",
              "// The calibrated probability is a real percentage. Base rate is 1.09%,",
              "// so anything above ~20% would mean it had been rescaled for looks.",
              "pm.test('probability is calibrated, not inflated', () => {",
              "  pm.expect(b.probability).to.be.above(0).and.below(0.20);",
              "  pm.expect(b.purchase_probability).to.be.closeTo(b.probability * 100, 0.01);",
              "});",
              "",
              "pm.test('top_factors are base-model features only', () => {",
              "  b.top_factors.forEach(f => pm.expect(f.feature).to.match(/^f_/));",
              "});",
              "",
              "pm.test('engagement layer fired', () => {",
              "  pm.expect(b.engagement.available).to.eql(true);",
              "  pm.expect(b.engagement.observed.events_total).to.be.above(1);",
              "});",
              "",
              "pm.test('engagement timeline never contains a payment', () => {",
              "  b.engagement.timeline.forEach(e => pm.expect(e.kind).to.not.eql('payment'));",
              "});",
              "",
              "pm.test('absent signal contributes exactly zero', () => {",
              "  b.ranking_factors.filter(f => f.status === 'no_data')",
              "    .forEach(f => pm.expect(f.contribution).to.eql(0));",
              "});",
              "",
              "pm.collectionVariables.set('savedProbability', b.purchase_probability);",
              "pm.collectionVariables.set('savedPriority', b.lead_priority.probability_percent);",
              "console.log('calibrated', b.purchase_probability + '%', '| ranking', b.lead_priority.probability_percent + '%');"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Same lead + Brand Brain — the key test",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/purchase-probability/{{leadEngaged}}?brand_brain_id={{brandBrainId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "purchase-probability",
            "{{leadEngaged}}"
          ],
          "query": [
            {
              "key": "brand_brain_id",
              "value": "{{brandBrainId}}",
              "description": "Override. Normally omitted — the endpoint resolves the Brand Brain from the lead's brand automatically."
            }
          ]
        },
        "description": "The same lead with an explicit brand_brain_id override.\n\nThis lead's brand now auto-resolves to the SAME Brand Brain document, so the override is a no-op and the whole response must be identical to request 2. That is the assertion: the override is honoured, and it changes nothing it should not.\n\nThe layers are still doing work - lead_priority sits away from the calibrated probability - it just does not depend on how the brand was resolved."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "pm.test('brand brain loaded from MongoDB', () => {",
              "  pm.expect(b.brand_brain.available).to.eql(true);",
              "  pm.expect(b.brand_brain.profile.sales_cycle_days).to.eql(1);",
              "  pm.expect(b.brand_brain.profile.target_seniority).to.eql('founder_c_level');",
              "});",
              "",
              "// THE INVARIANT. Brand context must never move the calibrated number.",
              "pm.test('calibrated probability is UNCHANGED by brand context', () => {",
              "  const before = Number(pm.collectionVariables.get('savedProbability'));",
              "  pm.expect(b.purchase_probability).to.eql(before);",
              "});",
              "",
              "// This lead's brand auto-resolves to the same document, so passing it",
              "// explicitly must change nothing at all.",
              "pm.test('the override resolves to the brand the lead already had', () => {",
              "  pm.expect(b.brand_brain.resolved_brand_brain_id)",
              "    .to.eql(pm.collectionVariables.get('brandBrainId'));",
              "  const before = Number(pm.collectionVariables.get('savedPriority'));",
              "  pm.expect(b.lead_priority.probability_percent).to.eql(before);",
              "});",
              "",
              "// ...but the layers are still doing work: the ranking sits away from the",
              "// calibrated probability, which is the whole point of keeping them apart.",
              "pm.test('the ranking is adjusted away from the calibrated probability', () => {",
              "  pm.expect(b.lead_priority.probability).to.not.eql(b.probability);",
              "  pm.expect(b.lead_priority.layers_applied)",
              "    .to.include.members(['engagement','brand_brain']);",
              "  pm.expect(b.lead_priority.calibrated).to.eql(false);",
              "});",
              "",
              "pm.test('sales cycle drives the recency half-life', () => {",
              "  pm.expect(b.engagement.recency_half_life_hours.derived_from).to.eql('brand_sales_cycle');",
              "  pm.expect(b.engagement.recency_half_life_hours.hours).to.eql(6);",
              "});",
              "",
              "pm.test('log-odds arithmetic is self-consistent', () => {",
              "  const lo = b.lead_priority.log_odds;",
              "  pm.expect(lo.base + lo.engagement + lo.brand_brain).to.be.closeTo(lo.total, 1e-6);",
              "  pm.expect(1 / (1 + Math.exp(-lo.total))).to.be.closeTo(b.lead_priority.probability, 1e-6);",
              "});",
              "",
              "pm.test('each layer stays inside its clamp', () => {",
              "  const lo = b.lead_priority.log_odds;",
              "  pm.expect(lo.engagement).to.be.within(b.engagement.bounds[0], b.engagement.bounds[1]);",
              "  pm.expect(lo.brand_brain).to.be.within(b.brand_brain.bounds[0], b.brand_brain.bounds[1]);",
              "});",
              "",
              "console.log('calibrated', b.purchase_probability + '%',",
              "            '| ranking', b.lead_priority.probability_percent + '%',",
              "            '| log-odds base', b.lead_priority.log_odds.base,",
              "            '+ eng', b.lead_priority.log_odds.engagement,",
              "            '+ brand', b.lead_priority.log_odds.brand_brain);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Unavailable — lead has no admissible form",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/purchase-probability/{{leadNoForm}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "purchase-probability",
            "{{leadNoForm}}"
          ]
        },
        "description": "House convention: ALWAYS HTTP 200. An unscorable lead returns nulls with a stable reason — never a fabricated 0."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('200 OK even when unscorable', () => pm.response.to.have.status(200));",
              "",
              "pm.test('null, never a fabricated zero', () => {",
              "  pm.expect(b.purchase_probability).to.eql(null);",
              "  pm.expect(b.fallback).to.eql(true);",
              "  pm.expect(b.availability.reason).to.eql('no_admissible_form_payload');",
              "});",
              "",
              "pm.test('layer keys still present so the UI never branches on existence', () => {",
              "  ['engagement','brand_brain','lead_priority','ranking_factors','signal_version']",
              "    .forEach(k => pm.expect(b).to.have.property(k));",
              "  pm.expect(b.lead_priority.priority).to.eql('Unavailable');",
              "});",
              "",
              "pm.test('layer reason describes the layer, not the base model', () => {",
              "  pm.expect(b.brand_brain.reason).to.eql('base_model_unavailable');",
              "  pm.expect(b.brand_brain.reason).to.not.eql(b.availability.reason);",
              "});",
              "",
              "// The model has nothing to say about this lead - but the CRM does.",
              "// The card must not go blank just because the probability did.",
              "pm.test('the card survives an unscorable lead', () => {",
              "  const card = b.lead_summary;",
              "  pm.expect(card.available).to.eql(true);",
              "  pm.expect(card.lead_score).to.be.a('number');",
              "  pm.expect(card.temperature).to.be.a('string');",
              "  pm.expect(b.lead_score).to.eql(card.lead_score);",
              "});",
              "",
              "pm.test('no probability means no invented lifetime value', () => {",
              "  pm.expect(b.lifetime_value).to.eql(null);",
              "  pm.expect(b.lead_summary.lifetime_value.amount).to.eql(null);",
              "  pm.expect(b.lead_summary.lifetime_value.reason)",
              "    .to.eql('no_admissible_form_payload');",
              "  // Deal size does not depend on the model, so it survives.",
              "  pm.expect(b.lead_summary.lifetime_value.potential_amount).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
