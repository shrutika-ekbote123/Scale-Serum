        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
              "const b = pm.response.json();",
              "pm.test('one run queued', () => { pm.expect(b.runs).to.have.lengthOf(1); pm.expect(b.runs[0].status).to.eql('queued'); });",
              "pm.test('timezone resolved from brands.timezone', () => pm.expect(b.timezone.name).to.be.a('string'));",
              "pm.collectionVariables.set('runId', b.runs[0].run_id);",
              "pm.collectionVariables.set('briefingDate', b.runs[0].date);",
              "pm.collectionVariables.set('pollCount', 0);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Runs - wait for the run to finish",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ai-briefings/{{brandId}}/runs?limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ai-briefings",
            "{{brandId}}",
            "runs"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(() => {}, 5000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const run = pm.response.json().runs.find(r => r.run_id === pm.collectionVariables.get('runId'));",
              "const n = Number(pm.collectionVariables.get('pollCount') || 0) + 1;",
              "pm.collectionVariables.set('pollCount', n);",
              "if (run && ['queued','running'].includes(run.status) && n < 40) {",
              "  postman.setNextRequest(pm.info.requestName);   // poll again (pre-request waits 5 s)",
              "} else {",
              "  pm.test('run completed', () => pm.expect(run && run.status).to.eql('completed'));",
              "  pm.test('all five sections recorded', () => pm.expect(Object.keys(run.sections).sort()).to.eql(['ads','all','leads','sales','whatsapp']));",
              "  pm.test('token usage recorded', () => pm.expect(run.usage).to.be.an('object'));",
              "}"
            ]
          }
        }
      ]
    },
