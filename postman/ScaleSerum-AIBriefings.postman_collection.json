              "pm.test('summary has a label and text', () => { pm.expect(b.summary.label).to.be.a('string').and.not.empty; pm.expect(b.summary.text).to.be.a('string').and.not.empty; });",
              "pm.test('five tabs listed for a service call', () => pm.expect(b.tabs.map(t => t.section)).to.eql(['all','sales','ads','whatsapp','leads']));",
              "pm.test('wording source recorded', () => pm.expect(['llm','template','none','composed']).to.include(b.wording.source));",
              "pm.test('blocks for the Read more modal', () => pm.expect(b.blocks).to.be.an('array'));",
              "pm.test('All label', () => pm.expect(b.summary.label).to.eql('Across all sections yesterday'));",
              "pm.test('at most 3 watch items', () => pm.expect(b.watch.length).to.be.at.most(3));",
              "pm.test('score card carried on every tab', () => pm.expect(b).to.have.property('score_card'));"
